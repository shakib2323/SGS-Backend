# Copy to .env on the server (chmod 600). NEVER commit the real .env.

# --- containers ---
GHCR_OWNER=your-github-username-lowercase
IMAGE_TAG=latest
API_DOMAIN=api.yourdomain.com
API_MEM_LIMIT=640m
MYSQL_BUFFER_POOL=128M

# --- database ---
DB_PASSWORD=change-me-long-random
DB_ROOT_PASSWORD=change-me-another-long-random

# --- app ---
# 48+ random chars:  openssl rand -base64 48
JWT_SECRET=
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
CORS_ORIGINS=https://www.yourdomain.com
PUBLIC_FILES_URL=https://api.yourdomain.com/files
TRUST_PROXY_HEADERS=true

# First admin (created only if no admin exists; must change password at first login; then delete these two lines)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# Cloudflare Turnstile secret for the public contact form (optional but recommended)
TURNSTILE_SECRET=
