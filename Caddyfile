{$API_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Processed images (UUID file names, never change) are served straight from the volume.
	handle_path /files/* {
		root * /srv/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		request_body {
			max_size 45MB
		}
		reverse_proxy api:8080
	}
}
